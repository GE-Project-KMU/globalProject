* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
# Machine evidence is a byte snapshot; hashes must survive a checkout.
docs/reports/*.json -text -eol whitespace=cr-at-eol
# Frozen training/runtime source hashes also identify the executed bytes.
# Python accepts both newline conventions; keep historical evidence unchanged.
*.py -text -eol whitespace=cr-at-eol
